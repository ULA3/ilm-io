# Copy to .env and fill in your keys (never commit .env)

# Required — YTL ILMU AI (chat, slides, agents)
ILMU_API_KEY=your_ilmu_api_key
ILMU_BASE_URL=https://api.ilmu.ai/v1
ILMU_MODEL=nemo-super

# Optional — audio upload (Whisper) and TTS fallback
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Required — Supabase (see dashboard: Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_or_secret_key
SUPABASE_STORAGE_BUCKET=ilmio-uploads

ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
MAX_UPLOAD_MB=50
