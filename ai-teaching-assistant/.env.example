# ── Local only (direct to FastAPI) ─────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Ngrok / public demo (recommended) ───────────────────────────────────
# Leave empty: browser calls /api on the same host; Next.js proxies to :8000
NEXT_PUBLIC_API_URL=

# Server-side proxy target (default localhost:8000)
BACKEND_URL=http://localhost:8000
